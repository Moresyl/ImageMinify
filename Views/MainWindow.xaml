<Window
    x:Class="ImageMinify.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ImageMinify.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ImageMinify.Models"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:vm="clr-namespace:ImageMinify.ViewModels"
    Title="ImageMinify"
    Width="1200"
    Height="820"
    MinWidth="1000"
    MinHeight="660"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    AllowDrop="True"
    Background="{DynamicResource Brush.Bg.Base}"
    FontFamily="{StaticResource Font.Family}"
    FontSize="{StaticResource Font.Size.Body}"
    Foreground="{DynamicResource Brush.Text.Primary}"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <!--
        CaptionHeight matches the strip drawn in row 0 exactly, so the whole strip drags the window
        and a double-click on it maximizes — both for free, and both stop working the moment the two
        numbers disagree. The resize border is 6, which is the grab margin Windows itself uses.

        GlassFrameThickness is 0 because this window paints its own ground edge to edge. It controls
        whether DWM extends its frame into the client area, which is a separate question from who
        draws the caption — conflating the two is what once left the window transparent over a
        backdrop that was never drawn, and so composited against black.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="{StaticResource Size.Caption}"
            CornerRadius="0"
            GlassFrameThickness="0"
            NonClientFrameEdges="None"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!--
            The results table's column widths, declared once and used by both the header row and the
            row template. A SharedSizeGroup would do the same job, but it makes every realised row
            participate in a measure negotiation with every other one — which is exactly the cost
            virtualization exists to avoid on a list that can hold ten thousand files.
        -->
        <GridLength x:Key="Col.State">20</GridLength>
        <GridLength x:Key="Col.Dimensions">118</GridLength>
        <GridLength x:Key="Col.Size">74</GridLength>
        <GridLength x:Key="Col.Arrow">18</GridLength>
        <GridLength x:Key="Col.Ratio">60</GridLength>
        <GridLength x:Key="Col.Actions">52</GridLength>

        <!-- The gap between two stacked cards, and between a section and the next one down. -->
        <Thickness x:Key="Gap.Card">0,12,0,0</Thickness>
        <Thickness x:Key="Gap.Section">0,16,0,0</Thickness>

        <!--
            A settings row: its label on the left, its control hard against the right edge of the
            rail. One style, so every row in the rail shares a baseline and a height and none of them
            can drift by a pixel.
        -->
        <Style x:Key="Field" TargetType="Grid">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="Field.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        </Style>

        <!-- The glyph beside a section heading. Lifted half a pixel onto the label's x-height, the
             same correction the buttons make. -->
        <Style x:Key="Section.Glyph" TargetType="Path" BasedOn="{StaticResource Icon}">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Margin" Value="0,-0.5,7,0" />
            <Setter Property="Fill" Value="{DynamicResource Brush.Text.Tertiary}" />
        </Style>

        <Style x:Key="Column.Header" TargetType="TextBlock" BasedOn="{StaticResource Text.Section}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==== Caption ================================================================= -->

            <Grid Grid.Row="0" Height="{StaticResource Size.Caption}">
                <StackPanel
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Path
                        Width="15"
                        Height="15"
                        Margin="0,-0.5,0,0"
                        Data="{StaticResource Icon.Compress}"
                        Fill="{DynamicResource Brush.Accent.Default}"
                        SnapsToDevicePixels="True"
                        Stretch="Uniform" />
                    <TextBlock
                        Margin="9,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.BodyStrong}"
                        Text="ImageMinify" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Caption}"
                        Text="图片压缩工具" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <!-- The glyph shows the theme you would switch *to*, not the one you are in:
                         a control labelled with its own current state gives you nothing to act on. -->
                    <Button Command="{Binding ToggleThemeCommand}" ToolTip="切换深色 / 浅色主题">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Window}">
                                <Setter Property="Tag" Value="{StaticResource Icon.Moon}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                        <Setter Property="Tag" Value="{StaticResource Icon.Sun}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button
                        Click="OnMinimizeClick"
                        Style="{StaticResource Button.Window}"
                        Tag="{StaticResource Icon.Window.Minimize}"
                        ToolTip="最小化" />

                    <Button Click="OnMaximizeClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Window}">
                                <Setter Property="Tag" Value="{StaticResource Icon.Window.Maximize}" />
                                <Setter Property="ToolTip" Value="最大化" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Tag" Value="{StaticResource Icon.Window.Restore}" />
                                        <Setter Property="ToolTip" Value="向下还原" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button
                        Click="OnCloseClick"
                        Style="{StaticResource Button.Window.Close}"
                        Tag="{StaticResource Icon.Window.Close}"
                        ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <!-- ==== Body ==================================================================== -->

            <Grid Grid.Row="1" Margin="16,2,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="356" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ~~~~ Sources ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="{StaticResource Inset.Card}"
                    Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Section.Glyph}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Text.Section}"
                                    Text="图片来源" />
                                <Border
                                    Margin="10,0,0,0"
                                    Style="{StaticResource Chip}"
                                    Visibility="{Binding HasSources, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding SourceSummary}" />
                                </Border>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button
                                    Command="{Binding AddFilesCommand}"
                                    Content="添加图片"
                                    Tag="{StaticResource Icon.Files}" />
                                <Button
                                    Margin="8,0,0,0"
                                    Command="{Binding AddFolderCommand}"
                                    Content="添加文件夹"
                                    Tag="{StaticResource Icon.FolderAdd}" />
                                <Button
                                    Margin="8,0,0,0"
                                    Command="{Binding ClearSourcesCommand}"
                                    Style="{StaticResource Button.Subtle}"
                                    Tag="{StaticResource Icon.Trash}"
                                    ToolTip="清空来源列表"
                                    Width="{StaticResource Size.Control}" />
                            </StackPanel>
                        </Grid>

                        <!-- Empty: the drop target, which is also the instruction. -->
                        <Border
                            Grid.Row="1"
                            Height="104"
                            Margin="{StaticResource Gap.Card}"
                            Style="{StaticResource Inset}"
                            Visibility="{Binding Sources.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
                            <StackPanel VerticalAlignment="Center">
                                <Path
                                    Width="26"
                                    Height="26"
                                    HorizontalAlignment="Center"
                                    Data="{StaticResource Icon.DropTarget}"
                                    Fill="{DynamicResource Brush.Text.Tertiary}"
                                    SnapsToDevicePixels="True"
                                    Stretch="Uniform" />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource Text.Secondary}"
                                    Text="把图片或文件夹拖到这里" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource Text.Caption}"
                                    Text="支持 JPG · PNG · WebP · BMP" />
                            </StackPanel>
                        </Border>

                        <!-- Populated: one chip per source, wrapping. A list would take a fixed
                             column of height for four entries that fit on one line. -->
                        <ScrollViewer
                            Grid.Row="1"
                            MaxHeight="104"
                            Margin="{StaticResource Gap.Card}"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding Sources.Count, Converter={StaticResource CountToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Sources}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SourceItem}">
                                        <!-- 14 is half of 28, which is this chip's capsule; the
                                             9.5 the style carries is sized for a 19px caption chip
                                             and would bow the ends at this height. -->
                                        <Border
                                            Height="28"
                                            Margin="0,0,8,8"
                                            Padding="10,0,3,0"
                                            CornerRadius="14"
                                            Style="{StaticResource Chip}"
                                            ToolTip="{Binding Path}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path
                                                    Width="{StaticResource Size.Icon.Small}"
                                                    Height="{StaticResource Size.Icon.Small}"
                                                    Margin="0,-0.5,7,0"
                                                    Fill="{DynamicResource Brush.Text.Tertiary}"
                                                    SnapsToDevicePixels="True"
                                                    Stretch="Uniform"
                                                    VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Data" Value="{StaticResource Icon.Image}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                    <Setter Property="Data" Value="{StaticResource Icon.Folder}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <TextBlock
                                                    MaxWidth="180"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource Text.Body}"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Button
                                                    Margin="6,0,0,0"
                                                    Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource Button.Icon.Small}"
                                                    Tag="{StaticResource Icon.Dismiss}"
                                                    ToolTip="移除" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ~~~~ Results ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="{StaticResource Gap.Card}"
                    Padding="{StaticResource Inset.Card}"
                    Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Quality}" Style="{StaticResource Section.Glyph}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Text.Section}"
                                    Text="压缩结果" />
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button
                                    Command="{Binding ExportReportCommand}"
                                    Content="导出报告"
                                    Style="{StaticResource Button.Subtle}"
                                    Tag="{StaticResource Icon.Export}" />
                                <Button
                                    Margin="8,0,0,0"
                                    Command="{Binding ClearResultsCommand}"
                                    Style="{StaticResource Button.Subtle}"
                                    Tag="{StaticResource Icon.Trash}"
                                    ToolTip="清空结果"
                                    Width="{StaticResource Size.Control}" />
                            </StackPanel>
                        </Grid>

                        <!-- Four figures, one line, all in tabular numerals so the run's headline
                             does not jitter sideways as the counts tick up. -->
                        <UniformGrid
                            Grid.Row="1"
                            Margin="{StaticResource Gap.Card}"
                            Columns="4"
                            Visibility="{Binding Summary.HasResults, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Summary.ProcessedFiles}" />
                                <TextBlock
                                    Margin="0,1,0,0"
                                    Style="{StaticResource Text.Caption}"
                                    Text="已压缩" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    Foreground="{DynamicResource Brush.Success}"
                                    Style="{StaticResource Text.Metric}"
                                    Text="{Binding Summary.BytesSavedFormatted}" />
                                <TextBlock
                                    Margin="0,1,0,0"
                                    Style="{StaticResource Text.Caption}"
                                    Text="节省空间" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Summary.OverallCompressionRatioDisplay}" />
                                <TextBlock
                                    Margin="0,1,0,0"
                                    Style="{StaticResource Text.Caption}"
                                    Text="平均压缩率" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Summary.ElapsedDisplay}" />
                                <TextBlock
                                    Margin="0,1,0,0"
                                    Style="{StaticResource Text.Caption}"
                                    Text="用时" />
                            </StackPanel>
                        </UniformGrid>

                        <!-- Column headers. Every width here comes from the same resource the row
                             template uses, which is what keeps the two grids on one set of rules. -->
                        <StackPanel Grid.Row="2" Margin="{StaticResource Gap.Section}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource Col.State}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource Col.Dimensions}" />
                                    <ColumnDefinition Width="{StaticResource Col.Size}" />
                                    <ColumnDefinition Width="{StaticResource Col.Arrow}" />
                                    <ColumnDefinition Width="{StaticResource Col.Size}" />
                                    <ColumnDefinition Width="{StaticResource Col.Ratio}" />
                                    <ColumnDefinition Width="{StaticResource Col.Actions}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource Column.Header}"
                                    Text="文件" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource Column.Header}"
                                    Text="尺寸" />
                                <TextBlock
                                    Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource Column.Header}"
                                    Text="原始" />
                                <TextBlock
                                    Grid.Column="5"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource Column.Header}"
                                    Text="压缩后" />
                                <TextBlock
                                    Grid.Column="6"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource Column.Header}"
                                    Text="压缩率" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                        </StackPanel>

                        <Grid Grid.Row="3">
                            <ListBox
                                Margin="0,2,0,0"
                                ItemContainerStyle="{StaticResource Row}"
                                ItemsSource="{Binding Results}"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:CompressionResult}">
                                        <Grid ToolTip="{Binding Error}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{StaticResource Col.State}" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="{StaticResource Col.Dimensions}" />
                                                <ColumnDefinition Width="{StaticResource Col.Size}" />
                                                <ColumnDefinition Width="{StaticResource Col.Arrow}" />
                                                <ColumnDefinition Width="{StaticResource Col.Size}" />
                                                <ColumnDefinition Width="{StaticResource Col.Ratio}" />
                                                <ColumnDefinition Width="{StaticResource Col.Actions}" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 6px is the smallest dot that still reads as a
                                                 deliberate colour rather than an artefact. -->
                                            <Ellipse
                                                Grid.Column="0"
                                                Width="6"
                                                Height="6"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Fill="{Binding State, Converter={StaticResource ResultStateToBrush}}" />

                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource Text.Body}"
                                                Text="{Binding FileName}"
                                                TextTrimming="CharacterEllipsis" />

                                            <TextBlock
                                                Grid.Column="2"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource Text.Numeric.Secondary}"
                                                Text="{Binding DimensionsDisplay}"
                                                TextTrimming="CharacterEllipsis" />

                                            <TextBlock
                                                Grid.Column="3"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource Text.Numeric.Secondary}"
                                                Text="{Binding OriginalSizeFormatted}" />

                                            <Path
                                                Grid.Column="4"
                                                Width="9"
                                                Height="9"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="{StaticResource Icon.ArrowRight}"
                                                Fill="{DynamicResource Brush.Text.Disabled}"
                                                SnapsToDevicePixels="True"
                                                Stretch="Uniform" />

                                            <TextBlock
                                                Grid.Column="5"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource Text.Numeric}"
                                                Text="{Binding CompressedSizeFormatted}" />

                                            <StackPanel
                                                Grid.Column="6"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                                <Path
                                                    Width="11"
                                                    Height="11"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Data="{StaticResource Icon.Warning}"
                                                    Fill="{DynamicResource Brush.Warning}"
                                                    SnapsToDevicePixels="True"
                                                    Stretch="Uniform"
                                                    ToolTip="未能达到目标大小，可尝试更小的尺寸或改用 WebP"
                                                    Visibility="{Binding TargetMissed, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{Binding State, Converter={StaticResource ResultStateToBrush}}"
                                                    Style="{StaticResource Text.Numeric}"
                                                    Text="{Binding CompressionRatioDisplay}" />
                                            </StackPanel>

                                            <!-- Always on. These used to appear only under the
                                                 pointer, which hid the one thing worth doing with a
                                                 finished row until the mouse happened to cross it.
                                                 The column is reserved for them either way, so a
                                                 row's figures never move when one is shown; the eye
                                                 is there only where there are two files to compare,
                                                 and the reveal button stays put when it is not,
                                                 because both are pinned to the same right edge. -->
                                            <StackPanel
                                                Grid.Column="7"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                                <Button
                                                    Command="{Binding DataContext.PreviewResultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource Button.Icon.Small}"
                                                    Tag="{StaticResource Icon.Eye}"
                                                    ToolTip="对比原图与压缩后"
                                                    Visibility="{Binding CanPreview, Converter={StaticResource BoolToVisibility}}" />
                                                <Button
                                                    Margin="4,0,0,0"
                                                    Command="{Binding DataContext.RevealResultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource Button.Icon.Small}"
                                                    Tag="{StaticResource Icon.Reveal}"
                                                    ToolTip="在文件资源管理器中显示" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="{Binding Results.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
                                <Path
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    Data="{StaticResource Icon.Compress}"
                                    Fill="{DynamicResource Brush.Text.Disabled}"
                                    SnapsToDevicePixels="True"
                                    Stretch="Uniform" />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource Text.Secondary}"
                                    Text="还没有压缩结果" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource Text.Caption}"
                                    Text="在右侧调好参数，然后点击“开始压缩”" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ~~~~ Settings rail ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

                <Border
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Style="{StaticResource Panel}">
                    <ScrollViewer Padding="{StaticResource Inset.Card}" VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- Presets -->
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Preset}" Style="{StaticResource Section.Glyph}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Text.Section}"
                                    Text="预设" />
                            </StackPanel>
                            <Border Margin="0,8,0,0" Style="{StaticResource Segment.Group}">
                                <ItemsControl ItemsSource="{Binding Presets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:CompressionPreset}">
                                            <RadioButton
                                                Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding Name}"
                                                Style="{StaticResource Segment}"
                                                ToolTip="{Binding Detail}">
                                                <!-- Both sides of the comparison are data, so it
                                                     cannot be a converter parameter. -->
                                                <RadioButton.IsChecked>
                                                    <MultiBinding Converter="{StaticResource MultiEquality}" Mode="OneWay">
                                                        <Binding Path="Key" />
                                                        <Binding Path="DataContext.ActivePresetKey" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </RadioButton.IsChecked>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <Border Margin="{StaticResource Gap.Section}" Style="{StaticResource Divider}" />

                            <!-- Format -->
                            <StackPanel Margin="{StaticResource Gap.Section}" Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Image}" Style="{StaticResource Section.Glyph}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Text.Section}"
                                    Text="输出格式" />
                            </StackPanel>
                            <Border
                                Margin="0,8,0,0"
                                IsEnabled="{Binding IsFormatSelectable}"
                                Style="{StaticResource Segment.Group}">
                                <UniformGrid Columns="4">
                                    <RadioButton
                                        Content="原格式"
                                        IsChecked="{Binding OutputFormat, Converter={StaticResource Equality}, ConverterParameter=original}"
                                        Style="{StaticResource Segment}" />
                                    <RadioButton
                                        Content="JPEG"
                                        IsChecked="{Binding OutputFormat, Converter={StaticResource Equality}, ConverterParameter=jpeg}"
                                        Style="{StaticResource Segment}" />
                                    <RadioButton
                                        Content="PNG"
                                        IsChecked="{Binding OutputFormat, Converter={StaticResource Equality}, ConverterParameter=png}"
                                        Style="{StaticResource Segment}" />
                                    <RadioButton
                                        Content="WebP"
                                        IsChecked="{Binding OutputFormat, Converter={StaticResource Equality}, ConverterParameter=webp}"
                                        Style="{StaticResource Segment}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock
                                Margin="0,7,0,0"
                                Style="{StaticResource Text.Caption}"
                                Text="覆盖原文件时无法转换格式"
                                TextWrapping="Wrap"
                                Visibility="{Binding IsOverwriting, Converter={StaticResource BoolToVisibility}}" />

                            <Border Margin="{StaticResource Gap.Section}" Style="{StaticResource Divider}" />

                            <!-- Quality -->
                            <Grid Margin="{StaticResource Gap.Section}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Quality}" Style="{StaticResource Section.Glyph}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Text.Section}"
                                        Text="画质" />
                                </StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource Text.Numeric}"
                                    Text="{Binding Quality}" />
                            </Grid>
                            <Slider
                                Margin="0,4,0,0"
                                IsEnabled="{Binding IsQualityEnabled}"
                                IsSnapToTickEnabled="True"
                                LargeChange="5"
                                Maximum="100"
                                Minimum="1"
                                SmallChange="1"
                                TickFrequency="1"
                                Value="{Binding Quality, Mode=TwoWay}" />
                            <Grid>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="更小" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource Text.Caption}"
                                    Text="更清晰" />
                            </Grid>

                            <Grid Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource Field.Label}" Text="目标大小" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <TextBox
                                        Width="72"
                                        HorizontalContentAlignment="Right"
                                        Text="{Binding TargetSizeKb}"
                                        ToolTip="每张图片压缩到不超过这个大小；0 表示不限制" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        Style="{StaticResource Field.Label}"
                                        Text="KB" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                Margin="0,7,0,0"
                                Style="{StaticResource Text.Caption}"
                                Text="已按目标大小自动搜索画质，上方滑块暂停使用"
                                TextWrapping="Wrap"
                                Visibility="{Binding IsQualityEnabled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                            <Border Margin="{StaticResource Gap.Section}" Style="{StaticResource Divider}" />

                            <!-- Resize -->
                            <StackPanel Margin="{StaticResource Gap.Section}" Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Resize}" Style="{StaticResource Section.Glyph}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Text.Section}"
                                    Text="尺寸" />
                            </StackPanel>
                            <Border Margin="0,8,0,0" Style="{StaticResource Segment.Group}">
                                <UniformGrid Columns="3">
                                    <RadioButton
                                        Content="保持原尺寸"
                                        IsChecked="{Binding ScaleMode, Converter={StaticResource Equality}, ConverterParameter=None}"
                                        Style="{StaticResource Segment}" />
                                    <RadioButton
                                        Content="限制长边"
                                        IsChecked="{Binding ScaleMode, Converter={StaticResource Equality}, ConverterParameter=LongestEdge}"
                                        Style="{StaticResource Segment}" />
                                    <RadioButton
                                        Content="按百分比"
                                        IsChecked="{Binding ScaleMode, Converter={StaticResource Equality}, ConverterParameter=Percent}"
                                        Style="{StaticResource Segment}" />
                                </UniformGrid>
                            </Border>
                            <Grid Style="{StaticResource Field}" Visibility="{Binding IsScaleValueEnabled, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Field.Label}" Text="数值" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <TextBox
                                        Width="72"
                                        HorizontalContentAlignment="Right"
                                        Text="{Binding ScaleValue}" />
                                    <TextBlock
                                        Width="22"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource Field.Label}"
                                        Text="{Binding ScaleUnit}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                Margin="0,7,0,0"
                                Style="{StaticResource Text.Caption}"
                                Text="只会缩小，不会把小图拉大"
                                TextWrapping="Wrap"
                                Visibility="{Binding IsScaleValueEnabled, Converter={StaticResource BoolToVisibility}}" />

                            <Border Margin="{StaticResource Gap.Section}" Style="{StaticResource Divider}" />

                            <!-- Processing switches -->
                            <StackPanel Margin="{StaticResource Gap.Section}" Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Tag}" Style="{StaticResource Section.Glyph}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Text.Section}"
                                    Text="处理方式" />
                            </StackPanel>

                            <Grid Style="{StaticResource Field}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Text.Body}" Text="清除元数据" />
                                    <TextBlock
                                        Margin="0,1,0,0"
                                        Style="{StaticResource Text.Caption}"
                                        Text="删除 GPS、相机信息与缩略图" />
                                </StackPanel>
                                <ToggleButton
                                    HorizontalAlignment="Right"
                                    IsChecked="{Binding StripMetadata}"
                                    Style="{StaticResource Switch}"
                                    ToolTip="清除元数据" />
                            </Grid>

                            <Grid Style="{StaticResource Field}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Text.Body}" Text="跳过变大的图片" />
                                    <TextBlock
                                        Margin="0,1,0,0"
                                        Style="{StaticResource Text.Caption}"
                                        Text="压缩后更大时保留原文件" />
                                </StackPanel>
                                <ToggleButton
                                    HorizontalAlignment="Right"
                                    IsChecked="{Binding SkipWhenLarger}"
                                    Style="{StaticResource Switch}"
                                    ToolTip="跳过变大的图片" />
                            </Grid>

                            <Grid Style="{StaticResource Field}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Text.Body}" Text="包含子文件夹" />
                                    <TextBlock
                                        Margin="0,1,0,0"
                                        Style="{StaticResource Text.Caption}"
                                        Text="递归处理文件夹内的所有层级" />
                                </StackPanel>
                                <ToggleButton
                                    HorizontalAlignment="Right"
                                    IsChecked="{Binding Recursive}"
                                    Style="{StaticResource Switch}"
                                    ToolTip="包含子文件夹" />
                            </Grid>

                            <Border Margin="{StaticResource Gap.Section}" Style="{StaticResource Divider}" />

                            <!-- Output routing -->
                            <StackPanel Margin="{StaticResource Gap.Section}" Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Output}" Style="{StaticResource Section.Glyph}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Text.Section}"
                                    Text="输出位置" />
                            </StackPanel>
                            <Border Margin="0,8,0,0" Style="{StaticResource Segment.Group}">
                                <UniformGrid Columns="4">
                                    <RadioButton
                                        Content="加后缀"
                                        IsChecked="{Binding OutputMode, Converter={StaticResource Equality}, ConverterParameter=Suffix}"
                                        Style="{StaticResource Segment}"
                                        ToolTip="写在原图旁边，文件名加上后缀" />
                                    <RadioButton
                                        Content="子文件夹"
                                        IsChecked="{Binding OutputMode, Converter={StaticResource Equality}, ConverterParameter=Subfolder}"
                                        Style="{StaticResource Segment}"
                                        ToolTip="写进原图所在目录下的 compressed 文件夹" />
                                    <RadioButton
                                        Content="指定目录"
                                        IsChecked="{Binding OutputMode, Converter={StaticResource Equality}, ConverterParameter=CustomFolder}"
                                        Style="{StaticResource Segment}"
                                        ToolTip="写到你选择的文件夹，并保留原有的目录层级" />
                                    <RadioButton
                                        Content="覆盖原图"
                                        IsChecked="{Binding OutputMode, Converter={StaticResource Equality}, ConverterParameter=Overwrite}"
                                        Style="{StaticResource Segment}"
                                        ToolTip="直接替换原文件，不保留备份" />
                                </UniformGrid>
                            </Border>

                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid" BasedOn="{StaticResource Field}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OutputMode}" Value="Suffix">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <TextBlock Style="{StaticResource Field.Label}" Text="文件名后缀" />
                                <TextBox
                                    Width="140"
                                    HorizontalAlignment="Right"
                                    Text="{Binding Suffix}" />
                            </Grid>

                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid" BasedOn="{StaticResource Field}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OutputMode}" Value="CustomFolder">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Height="{StaticResource Size.Control}"
                                    Padding="9,0"
                                    Style="{StaticResource Inset}"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    ToolTip="{Binding OutputFolder}">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Text.Secondary}"
                                        Text="{Binding OutputFolder}"
                                        TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Command="{Binding ChooseOutputFolderCommand}"
                                    Content="选择"
                                    MinWidth="0"
                                    Padding="12,0"
                                    Tag="{StaticResource Icon.OpenFolder}" />
                            </Grid>

                            <!-- The one setting that cannot be undone says so where it is chosen,
                                 not only in the confirmation that appears a click before the run. -->
                            <Border
                                Margin="0,10,0,0"
                                Padding="11,8"
                                Background="{DynamicResource Brush.Warning.Bg}"
                                BorderBrush="{DynamicResource Brush.Warning.Stroke}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Medium}"
                                SnapsToDevicePixels="True"
                                Visibility="{Binding IsOverwriting, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Width="13"
                                        Height="13"
                                        Margin="0,1,8,0"
                                        VerticalAlignment="Top"
                                        Data="{StaticResource Icon.Warning}"
                                        Fill="{DynamicResource Brush.Warning}"
                                        SnapsToDevicePixels="True"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        Width="270"
                                        Foreground="{DynamicResource Brush.Warning}"
                                        Style="{StaticResource Text.Body}"
                                        Text="原文件会被直接替换，且不进入回收站。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Margin="{StaticResource Gap.Section}" Style="{StaticResource Divider}" />

                            <!-- Engine -->
                            <StackPanel Margin="{StaticResource Gap.Section}" Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Target}" Style="{StaticResource Section.Glyph}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Text.Section}"
                                    Text="压缩引擎" />
                            </StackPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <Border Margin="0,0,6,6" Style="{StaticResource Chip}">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding EngineCapabilities.JpegOptimizerDisplay}" />
                                </Border>
                                <Border Margin="0,0,6,6" Style="{StaticResource Chip}">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding EngineCapabilities.PngQuantizationDisplay}" />
                                </Border>
                                <Border Margin="0,0,6,6" Style="{StaticResource Chip}">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding EngineCapabilities.PngLosslessDisplay}" />
                                </Border>
                                <Border Margin="0,0,6,6" Style="{StaticResource Chip.Accent}">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding EngineCapabilities.ParallelismDisplay}" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ==== Action bar ============================================================== -->

            <Border
                Grid.Row="2"
                Margin="16,12,16,16"
                Padding="16,12"
                Style="{StaticResource Panel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center">
                        <Grid>
                            <TextBlock
                                Style="{StaticResource Text.Numeric.Secondary}"
                                Text="{Binding SourceSummary}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding IsCompressing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            <TextBlock
                                Style="{StaticResource Text.Numeric}"
                                Text="{Binding ProgressText}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding IsCompressing, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <ProgressBar
                            Margin="0,9,0,0"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding ProgressValue, Mode=OneWay}"
                            Visibility="{Binding IsCompressing, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding CancelCommand}"
                            Content="停止"
                            MinHeight="{StaticResource Size.Action}"
                            Tag="{StaticResource Icon.Stop}"
                            Visibility="{Binding IsCompressing, Converter={StaticResource BoolToVisibility}}" />
                        <Button
                            MinWidth="128"
                            Command="{Binding StartCommand}"
                            Content="开始压缩"
                            Style="{StaticResource Button.Accent}"
                            Tag="{StaticResource Icon.Play}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==== Drag hint ==================================================================== -->

        <!--
            Hit-test invisible on purpose: an overlay that can be hit swallows the drop it is
            advertising, and the file lands nowhere.
        -->
        <Grid
            x:Name="DropHint"
            Background="{DynamicResource Brush.Bg.Scrim}"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border
                Padding="44,32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Brush.Bg.Flyout}"
                BorderBrush="{DynamicResource Brush.Accent.Stroke}"
                BorderThickness="2"
                CornerRadius="{StaticResource Radius.XLarge}"
                Effect="{DynamicResource Effect.Shadow.Flyout}">
                <StackPanel>
                    <Path
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Center"
                        Data="{StaticResource Icon.DropTarget}"
                        Fill="{DynamicResource Brush.Accent.Default}"
                        SnapsToDevicePixels="True"
                        Stretch="Uniform" />
                    <TextBlock
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource Text.Subtitle}"
                        Text="松开即可添加" />
                    <TextBlock
                        Margin="0,5,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource Text.Caption}"
                        Text="图片或整个文件夹都可以" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==== Dialog ====================================================================== -->

        <Grid
            Background="{DynamicResource Brush.Bg.Scrim}"
            Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Border
                Width="452"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Brush.Bg.Flyout}"
                BorderBrush="{DynamicResource Brush.Stroke.Default}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.XLarge}"
                Effect="{DynamicResource Effect.Shadow.Flyout}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="32"
                            Height="32"
                            Background="{Binding DialogSeverity, Converter={StaticResource SeverityToBrush}, ConverterParameter=Bg}"
                            BorderBrush="{Binding DialogSeverity, Converter={StaticResource SeverityToBrush}, ConverterParameter=Stroke}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Large}"
                            SnapsToDevicePixels="True">
                            <Path
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{Binding DialogSeverity, Converter={StaticResource SeverityToGeometry}}"
                                Fill="{Binding DialogSeverity, Converter={StaticResource SeverityToBrush}}"
                                SnapsToDevicePixels="True"
                                Stretch="Uniform" />
                        </Border>
                        <TextBlock
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource Text.Subtitle}"
                            Text="{Binding DialogTitle}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,14,0,0"
                        LineHeight="19"
                        Style="{StaticResource Text.Body}"
                        Text="{Binding DialogMessage}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,8,0,0"
                        LineHeight="17"
                        Style="{StaticResource Text.Caption}"
                        Text="{Binding DialogDetail}"
                        TextWrapping="Wrap"
                        Visibility="{Binding DialogDetail, Converter={StaticResource NullToVisibility}}" />

                    <StackPanel
                        Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding DialogCancelCommand}"
                            Content="取消"
                            MinHeight="{StaticResource Size.Action}"
                            Visibility="{Binding IsDialogCancellable, Converter={StaticResource BoolToVisibility}}" />
                        <Button
                            MinWidth="112"
                            Command="{Binding DialogConfirmCommand}"
                            Content="{Binding DialogConfirmText}"
                            Style="{StaticResource Button.Accent}"
                            Visibility="{Binding IsDialogDestructive, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        <Button
                            MinWidth="112"
                            Command="{Binding DialogConfirmCommand}"
                            Content="{Binding DialogConfirmText}"
                            Style="{StaticResource Button.Danger}"
                            Visibility="{Binding IsDialogDestructive, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==== Before / after ============================================================== -->

        <Grid
            Background="{DynamicResource Brush.Bg.Scrim}"
            Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolToVisibility}}">
            <Border
                MaxWidth="1040"
                MaxHeight="800"
                Margin="56"
                Padding="20"
                Background="{DynamicResource Brush.Bg.Flyout}"
                BorderBrush="{DynamicResource Brush.Stroke.Default}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.XLarge}"
                Effect="{DynamicResource Effect.Shadow.Flyout}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Two columns rather than an overlay, so a long file name is trimmed by the
                         column it is in instead of running underneath the buttons. -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource Text.Subtitle}"
                                Text="{Binding PreviewResult.FileName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Style="{StaticResource Text.Caption}"
                                Text="{Binding PreviewResult.DimensionsDisplay}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Width="{StaticResource Size.Control}"
                                Click="OnZoomOut"
                                Style="{StaticResource Button.Subtle}"
                                Tag="{StaticResource Icon.ZoomOut}"
                                ToolTip="缩小（减号键）" />
                            <!--
                                Fixed width, and the reason is not cosmetic. The number comes from
                                the surface, which recomputes it whenever the stage is resized; if
                                this button could grow with its text it would resize the header,
                                which would resize the stage, which would produce a new number.
                                "800%" is as wide as it ever gets, so the header is pinned to that.
                            -->
                            <Button
                                Width="62"
                                Click="OnZoomToggle"
                                Content="{Binding ElementName=Comparison, Path=EffectiveZoom, Converter={StaticResource Percent}}"
                                Style="{StaticResource Button.Subtle}"
                                ToolTip="在原始大小与适应窗口之间切换（1 / 0）" />
                            <Button
                                Width="{StaticResource Size.Control}"
                                Click="OnZoomIn"
                                Style="{StaticResource Button.Subtle}"
                                Tag="{StaticResource Icon.ZoomIn}"
                                ToolTip="放大（加号键）" />
                            <Button
                                Width="{StaticResource Size.Control}"
                                Margin="8,0,0,0"
                                Command="{Binding ClosePreviewCommand}"
                                Style="{StaticResource Button.Subtle}"
                                Tag="{StaticResource Icon.Dismiss}"
                                ToolTip="关闭（Esc）" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <!--
                            One element draws both pictures, the checkerboard under them and the
                            seam across them. It was a stack of Images whose widths were multiplied
                            together by converters, which worked until the layers had to agree on a
                            size the layout system had no opinion about — and it fell apart silently
                            when they stopped agreeing. It also could not magnify: at a size that
                            fits the dialog, a 4000px photograph has had every artefact the encoder
                            made resampled away before it reaches the screen, which is the one thing
                            this view exists to show.
                        -->
                        <controls:ComparisonSurface
                            x:Name="Comparison"
                            Background="{DynamicResource Brush.Bg.Inset}"
                            CheckerboardBrush="{DynamicResource Brush.Checkerboard}"
                            ComparedPath="{Binding PreviewResult.CompressedPath}"
                            CornerRadius="8"
                            OriginalPath="{Binding PreviewResult.OriginalPath}"
                            SeamBrush="{DynamicResource Brush.Accent.Default}"
                            SeamGlyph="{StaticResource Icon.Wipe}"
                            SeamGlyphBrush="{DynamicResource Brush.Text.OnAccent}"
                            Split="{Binding PreviewSplit}"
                            ToolTip="拖动对比 · 双击回到中间 · 滚轮缩放 · 右键拖动平移" />

                        <!--
                            A legend rather than a label for a region: which end is which stays true
                            wherever the seam is, so both stay up.

                            They belong to the stage, not to the picture — the seam is a fraction of
                            the stage, so at eight times magnification "left of the seam" is still
                            the left of what you are looking at even when the picture's own left
                            edge is far off screen.
                        -->
                        <Border
                            Margin="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{DynamicResource Brush.Bg.Flyout}"
                            IsHitTestVisible="False"
                            Style="{StaticResource Chip}">
                            <TextBlock Style="{StaticResource Text.Caption}" Text="原图" />
                        </Border>
                        <Border
                            Margin="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{DynamicResource Brush.Bg.Flyout}"
                            IsHitTestVisible="False"
                            Style="{StaticResource Chip}">
                            <TextBlock Style="{StaticResource Text.Caption}" Text="压缩后" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Numeric.Secondary}" Text="{Binding PreviewResult.OriginalSizeFormatted}" />
                            <Path
                                Width="10"
                                Height="10"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                Data="{StaticResource Icon.ArrowRight}"
                                Fill="{DynamicResource Brush.Text.Disabled}"
                                SnapsToDevicePixels="True"
                                Stretch="Uniform" />
                            <TextBlock Style="{StaticResource Text.Numeric}" Text="{Binding PreviewResult.CompressedSizeFormatted}" />
                            <Border Margin="12,0,0,0" Style="{StaticResource Chip.Success}">
                                <TextBlock
                                    Foreground="{DynamicResource Brush.Success}"
                                    Style="{StaticResource Text.Caption}"
                                    Text="{Binding PreviewResult.CompressionRatioDisplay}" />
                            </Border>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button
                                Command="{Binding OpenResultCommand}"
                                CommandParameter="{Binding PreviewResult}"
                                Content="打开图片"
                                Style="{StaticResource Button.Subtle}"
                                Tag="{StaticResource Icon.Image}" />
                            <Button
                                Margin="8,0,0,0"
                                Command="{Binding RevealResultCommand}"
                                CommandParameter="{Binding PreviewResult}"
                                Content="所在位置"
                                Style="{StaticResource Button.Subtle}"
                                Tag="{StaticResource Icon.Reveal}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ImageMinify</RootNamespace>
    <AssemblyName>ImageMinify</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Scratch and release folders live inside the project directory and hold whole build trees of
         their own. Their obj\**\*.cs would otherwise be swept into this project's compile glob and
         collide with its generated AssemblyInfo (CS0579). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;tmp\**;output\**;publish\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="MetadataExtractor" Version="2.8.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="bin\**\*" Exclude="bin\Debug\**\*;bin\Release\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>
</Project>

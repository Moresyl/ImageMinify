    <!--
        The caption buttons, drawn on a 10x10 grid rather than the 24x24 above because that is the
        size Windows draws them at, and half a pixel of blur is visible on a straight line.

        Each stroke is 1 unit wide and sits on whole coordinates, so at 100% scaling the lines land
        on the pixel grid instead of straddling it.
    -->
    <PathGeometry x:Key="Icon.Window.Minimize" Figures="M 0 5 L 10 5 L 10 6 L 0 6 Z" />
    <PathGeometry x:Key="Icon.Window.Maximize" Figures="M 0 0 L 10 0 L 10 10 L 0 10 Z M 1 1 L 1 9 L 9 9 L 9 1 Z" />
